{
  "name": "cafe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "hydrogen skills check --mode=warn && tsx --env-file=.env dev.ts",
    "start": "tsx --env-file=.env dev.ts",
    "build": "vite build --outDir=dist/client --emptyOutDir && cp -R public/. dist/client/ && mkdir -p dist-server-tmp && vite build --ssr src/server/handle-request.ts --outDir=dist-server-tmp --emptyOutDir && cp dist-server-tmp/handle-request.js dist-server/ && rm -rf dist-server-tmp && cp dist/client/index.html dist-server/client-assets.html && rm -f dist/client/index.html",
    "preview": "vite preview --host 0.0.0.0 --port 3001",
    "typecheck": "tsc --noEmit && hydrogen gql check --fail-on-warn"
  },
  "dependencies": {
    "@shopify/hydrogen": "2026.10.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
