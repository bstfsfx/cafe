# The WebDev Shopify integration injects SHOPIFY_STORE_DOMAIN and
# SHOPIFY_STOREFRONT_ACCESS_TOKEN at runtime. App code maps them to Hydrogen's
# canonical PUBLIC_* names only inside server-only modules.
# PUBLIC_STORE_DOMAIN=your-store.myshopify.com
# PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=0
# Numeric Shopify shop ID required for ShopifyScripts; stored as public config.
SHOP_ID=
# Set only after a production storefront domain is configured. Until then,
# the app omits canonical and og:url metadata rather than guessing an origin.
# PUBLIC_SITE_URL=https://your-public-storefront.example
